target

# Claude session runtime — scheduled-task state + locks live alongside the
# committed `.claude/settings.json` but must not be tracked.
.claude/scheduled_tasks.json
.claude/scheduled_tasks.lock

# Runtime lock files produced by stacks-bench-agent (BENCH_LOCK,
# test-lock, etc.). Live under operator's data dir; never tracked.
data/run/

# Defensive: a developer iterating locally may keep a `config.toml`
# at the repo root and pass it via `-c config.toml`. Resolution no
# longer auto-loads cwd, but ignore in case anyone leaves one here.
/config.toml
.sbagent
