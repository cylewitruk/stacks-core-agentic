# Ignore everything by default
*

# Keep repo metadata/config
!.gitignore
!.gitmodules

# Include specific top-level files
!README.md
!overview.md

# These directories are expected to be used by the framework and should be included in the repo, 
# but we want to ignore any files that may be added to them during execution so we only include
# the directories themselves and keep their contents ignored.
!data
!sessions

# The contents of these directories are provided by the framework and should be included in the repo.
!prompts
!prompts/**
!queries
!queries/**
!schemas
!schemas/**
!scripts
!scripts/**


# Special handling for repos directory and the stacks-core submodule
!repos
!repos/stacks-core