# Ignore everything by default
*

# Keep repo metadata/config
!.gitignore
!.gitmodules

# Include specific top-level files
!README.md
!overview.md

# Include only repo-owned directories
!data
!prompts
!prompts/**
!queries
!queries/**
!schemas
!schemas/**
!scripts
!scripts/**
!sessions

# Special handling for repos directory and the stacks-core submodule
!repos
!repos/stacks-core