# sccache as a long-lived systemd user unit.
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp /work/scripts/sccache.service ~/.config/systemd/user/sccache.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now sccache
#
# Keep it running across logout/login (recommended for an agent VM):
#   sudo loginctl enable-linger "$USER"
#
# Verify:
#   systemctl --user status sccache
#   sccache --show-stats
#
# Tail logs:
#   journalctl --user -u sccache -f

[Unit]
Description=sccache shared compilation cache
After=network.target

[Service]
Type=simple
# SCCACHE_NO_DAEMON=1 keeps sccache in the foreground so systemd can
# supervise the actual server process (instead of the short-lived parent
# that --start-server normally forks from).
Environment=SCCACHE_NO_DAEMON=1
Environment=SCCACHE_DIR=/work/sccache
Environment=SCCACHE_CACHE_SIZE=50G
# Idle timeout 0 = never shut down on idle; systemd manages lifecycle.
Environment=SCCACHE_IDLE_TIMEOUT=0
# Adjust if cargo isn't on the user's default PATH at unit-start time.
ExecStart=%h/.cargo/bin/sccache --start-server
ExecStop=%h/.cargo/bin/sccache --stop-server
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
