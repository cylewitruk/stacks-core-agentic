# .env — single source of truth for the bench-agent workflow.
#
# Copy this file to <framework-root>/.env, then let the phase scripts source
# it automatically via `_lib.sh`. By default:
#
#   FRAMEWORK_ROOT = parent dir of scripts/_lib.sh
#   AGENTIC_ENV_FILE = $FRAMEWORK_ROOT/.env
#
# You can still override either variable explicitly before invoking the
# scripts, but most users should not need to.

# Framework root
FRAMEWORK_ROOT="${FRAMEWORK_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"

# Static paths
OPT_SESSIONS_ROOT="${FRAMEWORK_ROOT}/sessions"
STACKS_BENCH_DATA_DIR="${FRAMEWORK_ROOT}/data/stacks-bench"
BENCH_LOCK="${STACKS_BENCH_DATA_DIR}/benchmark.lock"
TEST_LOCK="${STACKS_BENCH_DATA_DIR}/test.lock"
BASE="${FRAMEWORK_ROOT}/repos/stacks-core"
SOURCE_DIR=/mnt/chainstate/mainnet

# Per-session (set by `start-session` helper, exported into env.sh)
# OPT_SESSION_ID=20260506-123456
# OPT_SESSION_DIR=$OPT_SESSIONS_ROOT/$OPT_SESSION_ID/results
# WORKTREES=$OPT_SESSIONS_ROOT/$OPT_SESSION_ID/worktrees

# Benchmark range (canonical Nakamoto-era ranges to pick from)
#   5_000_000 – 5_200_000
#   6_500_000 – 6_800_000
#   7_300_000 – 7_500_000
STACKS_BENCH_NETWORK=mainnet
STACKS_BENCH_START_AT=5000000
STACKS_BENCH_COUNT=200000

# Optional override knobs
# STACKS_BENCH_END_AT=
# STACKS_BENCH_TIP=
# STACKS_BENCH_PARALLEL_AGENTS=2

# Codex
CODEX_MODEL=gpt-5.5
# Warn if the installed CLI differs from the version the scripts were last
# verified against. Leave empty to disable the warning.
EXPECTED_CODEX_VERSION=codex-cli\ 0.128.0
# Outer timeout for each `codex exec` invocation. Set to 0 to disable.
CODEX_EXEC_TIMEOUT_SEC=3600
# Conservative nonzero floor used when importing a single run without a rerun.
# This prevents demo sessions from treating every tiny delta as significant.
SINGLE_RUN_NOISE_FLOOR_PCT=1.0

# Build cache (optional but strongly recommended for parallel agents).
# sccache hashes rustc invocations and reuses outputs across worktrees, so
# common dependencies only build once even when multiple optimizers are
# running in parallel. Each worktree still has its own ./target — sccache
# fills it from the shared cache rather than recompiling.
#
# For best behavior, run sccache as a long-lived systemd user unit (see
# scripts/sccache.service). The cache dir + size live in that unit; the
# only thing cargo needs to know is the wrapper.
RUSTC_WRAPPER=sccache

# Do NOT set CARGO_INCREMENTAL=1 — it is incompatible with full LTO release
# builds (the build profile benchmarks use), and sccache cannot cache
# incremental artifacts anyway.
CARGO_INCREMENTAL=0
