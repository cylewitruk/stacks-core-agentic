# /work/.env — single source of truth for the bench-agent workflow.
#
# Copy this file to /work/.env on the agent VM, then `source /work/.env`
# (or `set -a; source /work/.env; set +a`) at the top of every script and
# prompt-render step.

# Static paths
OPT_SESSIONS_ROOT=/work/sessions
STACKS_BENCH_DATA_DIR=/work/data/stacks-bench
BENCH_LOCK=/work/data/stacks-bench/benchmark.lock
TEST_LOCK=/work/data/stacks-bench/test.lock
BASE=/work/repos/stacks-core
SOURCE_DIR=/mnt/chainstate/mainnet

# Per-session (set by `start-session` helper, exported into env.sh)
# OPT_SESSION_ID=20260506-123456
# OPT_SESSION_DIR=$OPT_SESSIONS_ROOT/$OPT_SESSION_ID/results
# WORKTREES=$OPT_SESSIONS_ROOT/$OPT_SESSION_ID/worktrees

# Benchmark range (canonical Nakamoto-era ranges to pick from)
#   5_000_000 – 5_200_000
#   6_500_000 – 6_800_000
#   7_300_000 – 7_500_000
STACKS_BENCH_NETWORK=mainnet
STACKS_BENCH_START_AT=5000000
STACKS_BENCH_COUNT=200000

# Optional override knobs
# STACKS_BENCH_END_AT=
# STACKS_BENCH_TIP=
# STACKS_BENCH_PARALLEL_AGENTS=2

# Codex
CODEX_MODEL=gpt-5.5

# Build cache (optional but strongly recommended for parallel agents).
# sccache hashes rustc invocations and reuses outputs across worktrees, so
# common dependencies only build once even when multiple optimizers are
# running in parallel. Each worktree still has its own ./target — sccache
# fills it from the shared cache rather than recompiling.
#
# For best behavior, run sccache as a long-lived systemd user unit (see
# scripts/sccache.service). The cache dir + size live in that unit; the
# only thing cargo needs to know is the wrapper.
RUSTC_WRAPPER=sccache

# Do NOT set CARGO_INCREMENTAL=1 — it is incompatible with full LTO release
# builds (the build profile benchmarks use), and sccache cannot cache
# incremental artifacts anyway.
CARGO_INCREMENTAL=0
