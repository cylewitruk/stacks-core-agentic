# Copy to /etc/sbagent/sbagent-session.env and edit for the benchmark server.
#
# This file contains paths and optional command arguments only. Do not store
# PATs, GitHub tokens, or inline secret values here. Keep the token itself in
# the path configured by publish.token_file in config.toml.

# Runtime config consumed by `sbagent -c`.
SBAGENT_CONFIG=/etc/sbagent/config.toml

# Operator repo path for humans and documentation. The service's
# WorkingDirectory= must be kept in sync; systemd does not expand this variable
# in WorkingDirectory=.
SBAGENT_OPERATOR_DIR=/srv/stacks-core-autopilot

# Optional reference path for the token file. The service does not read this
# variable directly; config.toml's publish.token_file should point here.
SBAGENT_TOKEN_FILE=/etc/sbagent/gh_token

# Optional extra args appended to `sbagent session run`.
# Examples:
#   SBAGENT_SESSION_ARGS=--start-at 7300000 --count 15000
#   SBAGENT_SESSION_ARGS=--warmup 2
SBAGENT_SESSION_ARGS=
